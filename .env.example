# Copy to .env on the host. Never commit real secrets.

# Initial administrator (used only when no admin account exists yet)
# ADMIN_EMAIL=farhan0701@gmail.com
# ADMIN_PASSWORD=

# Public origin used for production cookies
# AUTH_ORIGIN=https://zprop.tech
# AUTH_SECURE_COOKIE=1

# Required to send a code for password reset and email change
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=zproptech@gmail.com
# SMTP_PASS=
# SMTP_FROM=ZPROP <zproptech@gmail.com>
# Set to 0 on Windows if antivirus TLS scanning blocks Gmail
# SMTP_TLS_REJECT_UNAUTHORIZED=0

# Optional private storage overrides
# ZPROP_ACCOUNTS_DIR=
# ZPROP_ADMIN_DIR=
# ZPROP_DATA_DIR=
